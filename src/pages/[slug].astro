---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Site from '../layouts/Site.astro';
import LegalSections from '../components/LegalSections.astro';
export async function getStaticPaths() {
  return (await getCollection('pages', ({ data }) => data.kind === 'page'))
    .map(page => ({ params: { slug: page.id }, props: { page } }));
}
interface Props { page: CollectionEntry<'pages'>; }
const { page } = Astro.props;
const { Content } = await render(page);
const site = (await getEntry('shared', 'site'))!;
---
<Site title={page.data.title} description={page.data.description}>
  <article class:list={['page', { 'team': page.data.team, 'legal': page.id === 'impressum-datenschutz', 'fire': page.id === 'brandschutz' }]}>
    <div class="page-heading">
      <h1>{page.data.title}</h1>
      {page.data.image && <img class="hero-image" src={page.data.image} alt={page.data.imageAlt} fetchpriority="high" />}
      {page.data.team && <div class="team-grid">
        {page.data.team.map(person => <figure>
          <img src={person.image} alt={person.name} />
          <figcaption><h2>{person.name}</h2><p>{person.role}</p></figcaption>
        </figure>)}
      </div>}
    </div>
    <div class="page-content">
      <div class="prose">{page.id === 'impressum-datenschutz' ? <LegalSections /> : <Content />}</div>
      <a class:list={['back-link', { 'legal-home-link': page.id === 'impressum-datenschutz' }]} href="/" aria-label={site.data.backLabel}>
        <svg viewBox="0 0 50 50" aria-hidden="true"><circle cx="25" cy="25" r="24" fill="currentColor"/><path d="M27 12 14 25l13 13M15 25h23" fill="none" stroke="#282828" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {page.id === 'impressum-datenschutz' && <span>{site.data.backLabel}</span>}
      </a>
    </div>
  </article>
</Site>
