---
import { getEntry } from 'astro:content';
import { CONTACT_EMAIL, CONTACT_PHONE } from 'astro:env/server';
import { obfuscate } from 'altcha-lib/obfuscation';
const { contact } = (await getEntry('shared', 'site'))!.data;
// Encrypted with a key the browser has to find by proof of work, about a second on a desktop.
const sealed = await obfuscate(JSON.stringify({ email: CONTACT_EMAIL, phone: CONTACT_PHONE }), {
  cost: 40000, counterMin: 100, counterMax: 200,
});
---
<dialog id="contact-captcha" aria-labelledby="contact-captcha-title" data-contact={sealed}>
  <h2 id="contact-captcha-title">{contact.title}</h2>
  <p>{contact.hint}</p>
  <p class="captcha-status" role="status" data-checking={contact.checking} data-error={contact.error}></p>
  <div class="captcha-actions">
    <button class="captcha-close" type="button">{contact.close}</button>
    <button class="captcha-confirm" type="button">{contact.confirm}</button>
  </div>
</dialog>

<script>
  type Contact = { email: string; phone: string };

  const dialog = document.querySelector<HTMLDialogElement>('#contact-captcha')!;
  const status = dialog.querySelector<HTMLElement>('.captcha-status')!;
  const confirm = dialog.querySelector<HTMLButtonElement>('.captcha-confirm')!;
  const phoneLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[href="#telefon"]')];
  const emailLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[href="#email"]')];
  let controller: AbortController | undefined;

  const fromHex = (hex: string) => Uint8Array.from(hex.match(/../g)!, byte => parseInt(byte, 16));

  // Counterpart of altcha-lib's obfuscate(); its own deobfuscate() is not usable in browsers.
  async function unseal(sealed: string, controller: AbortController): Promise<Contact> {
    const [{ solveChallenge }, { deriveKey }] = await Promise.all([
      import('altcha-lib'), import('altcha-lib/algorithms/web/pbkdf2'),
    ]);
    const { parameters, cipher } = JSON.parse(atob(sealed));
    const solution = await solveChallenge({ challenge: { parameters }, controller, deriveKey });
    if (!solution) throw new Error('Captcha not solved');
    const key = await crypto.subtle.importKey('raw', fromHex(solution.derivedKey), 'AES-GCM', false, ['decrypt']);
    const data = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: fromHex(cipher.iv) }, key, fromHex(cipher.data));
    return JSON.parse(new TextDecoder().decode(data));
  }

  function reveal({ email, phone }: Contact) {
    for (const link of phoneLinks) { link.href = `tel:${phone.replace(/\s/g, '')}`; link.textContent = phone; }
    for (const link of emailLinks) { link.href = `mailto:${email}`; link.textContent = email; }
    for (const link of [...phoneLinks, ...emailLinks]) {
      link.removeEventListener('click', open);
      link.removeAttribute('aria-haspopup');
    }
    dialog.close(); // Returns focus to the activated link, which now holds the details.
  }

  async function check() {
    const current = controller = new AbortController();
    confirm.disabled = true;
    status.textContent = status.dataset.checking!;
    try {
      const contact = await unseal(dialog.dataset.contact!, current);
      if (!current.signal.aborted) reveal(contact);
    } catch {
      if (current.signal.aborted) return;
      status.textContent = status.dataset.error!;
      confirm.disabled = false;
    }
  }

  function open(event: Event) {
    event.preventDefault();
    status.textContent = '';
    confirm.disabled = false;
    dialog.showModal();
    confirm.focus();
  }

  for (const link of [...phoneLinks, ...emailLinks]) {
    link.addEventListener('click', open);
    link.setAttribute('aria-haspopup', 'dialog');
  }
  confirm.addEventListener('click', check);
  dialog.querySelector('.captcha-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => controller?.abort());
</script>
